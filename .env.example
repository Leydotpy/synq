# Invitation email delivery. Keep real credentials in an untracked .env file.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Synq Meet <no-reply@example.com>
SERVER_EMAIL=Synq Meet <errors@example.com>
MEETING_EMAIL_REPLY_TO=
MEETING_EMAIL_PRODUCT_NAME=Synq

# Public frontend used to build signed meeting links in actionable emails.
MEETING_FRONTEND_BASE_URL=https://meet.example.com

# Redis/Celery are required for non-blocking delivery and due-time reminders.
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
MEETING_INVITATION_REMINDER_SWEEP_SECONDS=60
MEETING_INVITATION_REMINDER_BATCH_SIZE=500
